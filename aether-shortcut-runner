#!/data/data/com.termux/files/usr/bin/bash
set -u
set -o pipefail

VERSION="1.5.0"
SAMAN_TUNNEL_VERSION="1.5.0"
AETHER_BASE_VERSION="1.8.0"
MODE="${1:-}"

CORE_BIN="${SAMAN_AETHER_CORE:-$PREFIX/bin/saman-aether-core}"
STATE_DIR="$HOME/.saman-aether"
PID_FILE="$STATE_DIR/aether.pid"
MAX_CURRENT_LOG_BYTES=$((5 * 1024 * 1024))
MAX_PREVIOUS_LOG_BYTES=$((1024 * 1024))

SOCKS_PORT=1819
HTTP_PORT=1820

mkdir -p "$STATE_DIR"

clear
echo "================================"
echo "       SAMAN AETHER"
echo "     Termux v$VERSION"
echo "   Aether Core v$AETHER_BASE_VERSION"
echo " Saman Tunnel v$SAMAN_TUNNEL_VERSION"
echo "================================"
echo "Mode: $MODE"
echo

if [ ! -x "$CORE_BIN" ]; then
    echo "ERROR: patched Saman Aether Core is not installed."
    echo
    echo "Run:"
    echo "curl -fsSL https://raw.githubusercontent.com/velnox4827/saman-aether/main/install.sh | bash"
    exit 1
fi

export AETHER_SMART_WG_MAX_RTT_MS=650
export AETHER_SMART_MASQUE_H3_MAX_VERIFY_MS=1800
export AETHER_SMART_MASQUE_H2_MAX_VERIFY_MS=2500
export AETHER_SMART_SHORT_LIVED_SECS=20

core_pid_valid() {
    local pid="${1:-}" expected actual
    [[ "$pid" =~ ^[0-9]+$ ]] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    expected="$(readlink -f "$CORE_BIN" 2>/dev/null || true)"
    actual="$(readlink -f "/proc/$pid/exe" 2>/dev/null || true)"
    [ -n "$expected" ] && [ "$actual" = "$expected" ]
}

core_pids() {
    local proc expected actual
    expected="$(readlink -f "$CORE_BIN" 2>/dev/null || true)"
    [ -n "$expected" ] || return 0
    for proc in /proc/[0-9]*; do
        [ -r "$proc/exe" ] || continue
        actual="$(readlink -f "$proc/exe" 2>/dev/null || true)"
        [ "$actual" = "$expected" ] && printf '%s\n' "${proc##*/}"
    done
}

stop_pid() {
    local pid="$1"
    core_pid_valid "$pid" || return 0
    kill -TERM "$pid" 2>/dev/null || true
    for _ in $(seq 1 50); do core_pid_valid "$pid" || return 0; sleep 0.1; done
    echo "Aether Core PID $pid did not stop in 5 seconds; forcing stop..."
    core_pid_valid "$pid" && kill -KILL "$pid" 2>/dev/null || true
}

stop_core() {
    local pid="${1:-}"
    [ -n "$pid" ] || { [ -s "$PID_FILE" ] && pid="$(<"$PID_FILE")"; }
    [ -n "$pid" ] && stop_pid "$pid"
    if [ -s "$PID_FILE" ] && [ "$(<"$PID_FILE")" = "$pid" ]; then
        rm -f "$PID_FILE"
    fi
}

stop_orphan_cores() {
    local pid
    while IFS= read -r pid; do
        [ -n "$pid" ] || continue
        echo "Stopping orphaned canonical Aether Core PID $pid..."
        stop_pid "$pid"
    done < <(core_pids)
    rm -f "$PID_FILE"
}

port_listening() {
    local port="$1"

    ss -ltnH 2>/dev/null |
        awk -v suffix=":$port" '
            $4 ~ (suffix "$") { found=1 }
            END { exit(found ? 0 : 1) }
        '
}

wait_local_ports() {
    local i
    local socks_busy
    local http_busy
    local announced=0

    for i in $(seq 0 8); do
        socks_busy=0
        http_busy=0

        port_listening "$SOCKS_PORT" && socks_busy=1
        port_listening "$HTTP_PORT" && http_busy=1

        if [ "$socks_busy" -eq 0 ] &&
           [ "$http_busy" -eq 0 ]; then
            if [ "$announced" -eq 1 ]; then
                echo "Local proxy ports are free."
            fi
            return 0
        fi

        if [ "$announced" -eq 0 ]; then
            echo "Waiting for local proxy port hand-off..."
            announced=1
        fi

        [ "$i" -eq 8 ] && break
        sleep 0.25
    done

    echo
    echo "Local proxy port is still busy:"
    port_listening "$SOCKS_PORT" &&
        echo "  SOCKS5 :1819 is listening"
    port_listening "$HTTP_PORT" &&
        echo "  HTTP   :1820 is listening"
    echo
    echo "Stop the other local proxy first."
    return 1
}

stop_orphan_cores
wait_local_ports || exit 1

command -v termux-wake-lock >/dev/null 2>&1 &&
    termux-wake-lock >/dev/null 2>&1 || true

COMMON_ARGS=(
    --bind "127.0.0.1:$SOCKS_PORT"
    --http-proxy "127.0.0.1:$HTTP_PORT"
    --reconnect-secs 1
)

case "$MODE" in
    MASQUE|MASQUE_H3)
        MODE_KEY="masque-h3"
        MODE_LABEL="MASQUE H3"
        ARGS=(
            --masque
            -4
            "${COMMON_ARGS[@]}"
            --scan balanced
            --noize firewall
            --quick-reconnect
        )
        ;;

    MASQUE_H2)
        MODE_KEY="masque-h2"
        MODE_LABEL="MASQUE H2"
        ARGS=(
            --masque
            --h2
            -4
            "${COMMON_ARGS[@]}"
            --scan balanced
            --noize firewall
            --quick-reconnect
        )
        ;;

    WG)
        MODE_KEY="wg"
        MODE_LABEL="WireGuard"
        ARGS=(
            --wg
            -4
            "${COMMON_ARGS[@]}"
            --scan balanced
            --noize balanced
            --keepalive 5
            --quick-reconnect
        )
        ;;

    GOOL)
        MODE_KEY="gool"
        MODE_LABEL="GOOL"
        ARGS=(
            --gool
            -4
            "${COMMON_ARGS[@]}"
            --scan balanced
            --noize balanced
            --keepalive 5
            --quick-reconnect
        )
        ;;

    *)
        echo "Unknown mode: $MODE"
        echo "Valid: MASQUE / MASQUE_H2 / WG / GOOL"
        exit 1
        ;;
esac

LOG="$HOME/aether-${MODE_KEY}.log"
PREVIOUS_LOG="$HOME/aether-${MODE_KEY}.previous.log"

rotate_mode_logs() {
    local tmp
    if [ -f "$LOG" ]; then
        tmp="$(mktemp "$STATE_DIR/log.XXXXXX")"
        tail -c "$MAX_PREVIOUS_LOG_BYTES" "$LOG" > "$tmp" 2>/dev/null || true
        mv -f "$tmp" "$PREVIOUS_LOG"
    fi
    if [ -f "$PREVIOUS_LOG" ] && [ "$(wc -c < "$PREVIOUS_LOG" 2>/dev/null || echo 0)" -gt "$MAX_PREVIOUS_LOG_BYTES" ]; then
        tmp="$(mktemp "$STATE_DIR/log.XXXXXX")"
        tail -c "$MAX_PREVIOUS_LOG_BYTES" "$PREVIOUS_LOG" > "$tmp" 2>/dev/null || true
        mv -f "$tmp" "$PREVIOUS_LOG"
    fi
    : > "$LOG"
}

rotate_mode_logs

country_name() {
    case "$1" in
        IR) echo "Iran" ;;
        DE) echo "Germany" ;;
        NL) echo "Netherlands" ;;
        FR) echo "France" ;;
        GB) echo "United Kingdom" ;;
        US) echo "United States" ;;
        CA) echo "Canada" ;;
        IT) echo "Italy" ;;
        FI) echo "Finland" ;;
        SE) echo "Sweden" ;;
        NO) echo "Norway" ;;
        CH) echo "Switzerland" ;;
        AT) echo "Austria" ;;
        ES) echo "Spain" ;;
        BE) echo "Belgium" ;;
        PL) echo "Poland" ;;
        RO) echo "Romania" ;;
        CZ) echo "Czechia" ;;
        TR) echo "Turkey" ;;
        AE) echo "UAE" ;;
        SG) echo "Singapore" ;;
        JP) echo "Japan" ;;
        HK) echo "Hong Kong" ;;
        IN) echo "India" ;;
        RU) echo "Russia" ;;
        "") echo "Unknown" ;;
        *) echo "$1" ;;
    esac
}

get_exit_info() {
    local trace

    trace="$(
        curl -4 \
            --silent \
            --max-time 15 \
            --socks5-hostname "127.0.0.1:$SOCKS_PORT" \
            https://www.cloudflare.com/cdn-cgi/trace \
            2>/dev/null || true
    )"

    CHECK_IP="$(
        printf '%s\n' "$trace" |
            sed -n 's/^ip=//p' |
            head -n1
    )"

    CHECK_CC="$(
        printf '%s\n' "$trace" |
            sed -n 's/^loc=//p' |
            head -n1
    )"
}

connection_phase() {
    local t

    t="$(tail -n 120 "$LOG" 2>/dev/null || true)"

    if printf '%s\n' "$t" |
        grep -Eqi 'smart reconnect WG.*RTT.*scanning fresh'; then
        echo "WG cached endpoint too slow — fresh balanced scan"

    elif printf '%s\n' "$t" |
        grep -Eqi 'smart reconnect MASQUE.*slower than'; then
        echo "MASQUE cached gateway too slow — fresh balanced scan"

    elif printf '%s\n' "$t" |
        grep -Eqi 'smart reconnect GOOL.*died after'; then
        echo "GOOL pair was short-lived — fresh balanced scan"

    elif printf '%s\n' "$t" |
        grep -Eqi 'smart reconnect.*died after'; then
        echo "Cached path was short-lived — fresh balanced scan"

    elif printf '%s\n' "$t" |
        grep -Eqi 'verifying cached'; then
        echo "Checking cached endpoint"

    elif printf '%s\n' "$t" |
        grep -Eqi 'blacklisting and rescanning|scanning fresh'; then
        echo "Fresh balanced scan"

    elif printf '%s\n' "$t" |
        grep -Eqi 'hunting for .*working|scan mode=balanced'; then
        echo "Scanning balanced endpoints"

    elif printf '%s\n' "$t" |
        grep -Eqi 'establishing inner|inner endpoint'; then
        echo "Establishing inner tunnel"

    elif printf '%s\n' "$t" |
        grep -Eqi 'establishing outer'; then
        echo "Establishing outer tunnel"

    elif printf '%s\n' "$t" |
        grep -Eqi 'validating.*tunnel'; then
        echo "Validating tunnel"

    else
        echo "Preparing $MODE_LABEL"
    fi
}

CORE_PID=""
WATCH_PID=""
GUARD_PID=""

guard_log_size() {
    local tmp size
    while core_pid_valid "$CORE_PID"; do
        size="$(wc -c < "$LOG" 2>/dev/null || echo 0)"
        if [[ "$size" =~ ^[0-9]+$ ]] && [ "$size" -gt "$MAX_CURRENT_LOG_BYTES" ]; then
            tmp="$(mktemp "$STATE_DIR/log.XXXXXX")"
            tail -c "$MAX_PREVIOUS_LOG_BYTES" "$LOG" > "$tmp" 2>/dev/null || true
            mv -f "$tmp" "$PREVIOUS_LOG"
            : > "$LOG"
            printf '%s\n' "[Saman] Active log exceeded $MAX_CURRENT_LOG_BYTES bytes and was rotated." >> "$LOG"
        fi
        sleep 15
    done
}

start_core() {
    "$CORE_BIN" "${ARGS[@]}" >>"$LOG" 2>&1 &
    CORE_PID=$!
    printf '%s\n' "$CORE_PID" > "$PID_FILE"
    guard_log_size &
    GUARD_PID=$!
}

cleanup() {
    [ -n "$WATCH_PID" ] &&
        kill "$WATCH_PID" 2>/dev/null || true
    [ -n "$GUARD_PID" ] &&
        kill "$GUARD_PID" 2>/dev/null || true

    stop_core "${CORE_PID:-}"

    command -v termux-wake-unlock >/dev/null 2>&1 &&
        termux-wake-unlock >/dev/null 2>&1 || true
}

trap cleanup INT TERM EXIT

wait_ready() {
    local i
    local phase=""
    local previous_phase=""

    echo
    echo "Connecting..."

    # Same 120-second maximum, checked every 250 ms.
    for i in $(seq 1 480); do
        if ! kill -0 "$CORE_PID" 2>/dev/null; then
            echo
            echo "Aether Core stopped before SOCKS5 became ready."
            echo "Log: $LOG"
            return 1
        fi

        # No TCP readiness connection is opened here, so this checker
        # does not generate artificial SOCKS "early eof" entries.
        if grep -Eqi \
            'socks5 server listening|socks5.*listening|listening.*socks5' \
            "$LOG" 2>/dev/null; then
            return 0
        fi

        if [ $((i % 4)) -eq 0 ]; then
            phase="$(connection_phase)"

            if [ "$phase" != "$previous_phase" ]; then
                echo "  $phase"
                previous_phase="$phase"
            fi
        fi

        sleep 0.25
    done

    echo
    echo "SOCKS5 did not become ready within 120 seconds."
    echo "Log: $LOG"
    return 1
}

start_core

if ! wait_ready; then
    exit 1
fi

echo
echo "================================"
echo "       AETHER CONNECTED"
echo " Mode : $MODE_LABEL"
echo " SOCKS5       127.0.0.1:$SOCKS_PORT"
echo " HTTP CONNECT 127.0.0.1:$HTTP_PORT"
echo " Scan : balanced"
echo " Smart Reconnect: ON"
echo "================================"

echo
echo "Checking exit IP..."

get_exit_info

CURRENT_IP="$CHECK_IP"
CURRENT_CC="$CHECK_CC"

echo
echo "================================"

if [ -n "$CURRENT_IP" ]; then
    CURRENT_COUNTRY="$(country_name "$CURRENT_CC")"
    echo " Exit IP : $CURRENT_IP"
    echo " Country : $CURRENT_COUNTRY ($CURRENT_CC)"
else
    echo " Exit IP : Unknown"
    echo " Country : Unknown"
fi

echo "================================"

watch_aether_events() {
    local need_check=0
    local new_ip
    local new_cc
    local old_country
    local new_country

    tail -n 0 -F "$LOG" 2>/dev/null |
    while IFS= read -r line; do
        case "$line" in
            *"reconnecting"*|\
            *"Restarting after network change"*|\
            *"blacklisting and rescanning"*|\
            *"scanning fresh"*|\
            *"smart reconnect"*)
                need_check=1
                ;;
        esac

        [ "$need_check" -eq 1 ] || continue

        SUCCESS=0

        case "$MODE" in
            GOOL)
                case "$line" in
                    *"[inner] wireguard tunnel validated"*|\
                    *"socks5 server listening"*)
                        SUCCESS=1
                        ;;
                esac
                ;;

            WG)
                case "$line" in
                    *"wireguard tunnel validated"*|\
                    *"socks5 server listening"*)
                        SUCCESS=1
                        ;;
                esac
                ;;

            MASQUE|MASQUE_H3|MASQUE_H2)
                case "$line" in
                    *"socks5 server listening"*)
                        SUCCESS=1
                        ;;
                esac
                ;;
        esac

        [ "$SUCCESS" -eq 1 ] || continue

        sleep 0.5
        get_exit_info

        new_ip="$CHECK_IP"
        new_cc="$CHECK_CC"

        [ -n "$new_ip" ] || continue
        need_check=0

        if [ "$new_ip" != "$CURRENT_IP" ]; then
            old_country="$(country_name "$CURRENT_CC")"
            new_country="$(country_name "$new_cc")"

            echo
            echo "================================"
            echo "       EXIT IP CHANGED"
            echo "================================"
            echo " Old IP  : $CURRENT_IP"
            echo " New IP  : $new_ip"
            echo " Country : $old_country ($CURRENT_CC)"
            echo "        -> $new_country ($new_cc)"
            echo " Time    : $(date '+%H:%M:%S')"
            echo "================================"

            CURRENT_IP="$new_ip"
            CURRENT_CC="$new_cc"
        fi
    done
}

watch_aether_events &
WATCH_PID=$!

echo
echo "Aether is monitoring connection..."
echo "Log: $LOG"
echo
echo "Returning to Home..."

am start \
    -a android.intent.action.MAIN \
    -c android.intent.category.HOME \
    >/dev/null 2>&1 || true

while true; do
    wait "$CORE_PID"
    RC=$?

    if [ -s "$PID_FILE" ] && [ "$(<"$PID_FILE")" = "$CORE_PID" ]; then
        rm -f "$PID_FILE"
    fi

    if [ "$RC" -ne 101 ]; then
        exit "$RC"
    fi

    {
        echo
        echo "Aether exited with code 101."
        echo "Restarting after network change..."
        date
    } >>"$LOG"

    echo
    echo "Network change detected — restarting Aether..."

    wait_local_ports || exit 1
    sleep 0.25

    start_core

    if ! wait_ready; then
        exit 1
    fi

    echo "Aether reconnected."
done
