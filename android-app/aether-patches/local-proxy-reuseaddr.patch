+fn bind_reusable_tcp_listener(listen: SocketAddr) -> Result<TcpListener> {
+    let socket = if listen.is_ipv4() {
+        TcpSocket::new_v4()?
+    } else {
+        TcpSocket::new_v6()?
+    };
+
+    // Allow a clean immediate restart after the previous local proxy closes.
+    // SO_REUSEPORT is deliberately not enabled, so another active listener
+    // still owns and blocks the same local port.
+    socket.set_reuseaddr(true)?;
+    socket.bind(listen)?;
+    Ok(socket.listen(1024)?)
+}
