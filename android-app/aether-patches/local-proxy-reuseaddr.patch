+fn bind_reusable_tcp_listener(listen: SocketAddr) -> Result<TcpListener> {
+    let socket = if listen.is_ipv4() {
+        TcpSocket::new_v4()?
+    } else {
+        TcpSocket::new_v6()?
+    };
+
+    // Make local proxy restart tolerant of recently closed TCP sockets.
+    // SO_REUSEPORT is deliberately NOT enabled: another active listener
+    // must still block ownership of the same local proxy port.
+    socket.set_reuseaddr(true)?;
+    socket.bind(listen)?;
+    Ok(socket.listen(1024)?)
+}
