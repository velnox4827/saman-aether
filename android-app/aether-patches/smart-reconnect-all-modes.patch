+fn smart_wg_cached_max_rtt() -> std::time::Duration {
+    let ms = std::env::var("AETHER_SMART_WG_MAX_RTT_MS")
+        .ok()
+        .and_then(|v| v.parse::<u64>().ok())
+        .filter(|&v| v > 0)
+        .unwrap_or(650);
+    std::time::Duration::from_millis(ms)
+}
+
+fn smart_masque_cached_max_verify() -> std::time::Duration {
+    let key = if masque_h2::enabled() {
+        "AETHER_SMART_MASQUE_H2_MAX_VERIFY_MS"
+    } else {
+        "AETHER_SMART_MASQUE_H3_MAX_VERIFY_MS"
+    };
+
+    let default_ms = if masque_h2::enabled() { 2500 } else { 1800 };
+
+    let ms = std::env::var(key)
+        .ok()
+        .and_then(|v| v.parse::<u64>().ok())
+        .filter(|&v| v > 0)
+        .unwrap_or(default_ms);
+
+    std::time::Duration::from_millis(ms)
+}
+
+fn smart_short_lived_threshold() -> std::time::Duration {
+    let secs = std::env::var("AETHER_SMART_SHORT_LIVED_SECS")
+        .ok()
+        .and_then(|v| v.parse::<u64>().ok())
+        .filter(|&v| v > 0)
+        .unwrap_or(20);
+    std::time::Duration::from_secs(secs)
+}
